# --- Interlock ---
INTERLOCK_API_PORT=8787
INTERLOCK_DB=./interlock.db
HOLD_TIMEOUT_MS=120000

# --- Upstream PayPal MCP server ---
# The command Interlock spawns and proxies. Swap for your own if different.
UPSTREAM_COMMAND=npx
UPSTREAM_ARGS=-y,@paypal/mcp,--tools=all
PAYPAL_ACCESS_TOKEN=
PAYPAL_ENVIRONMENT=

# --- AI gates ---
# AI_PROVIDER picks which key below is used: anthropic | groq.
# Leave that provider's key empty to run in MOCK mode (heuristics only) so you
# can build the proxy on day 1 without touching a model. A key that is set but
# fails (no credit, bad key, outage) never falls back to mock: payments hold.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
